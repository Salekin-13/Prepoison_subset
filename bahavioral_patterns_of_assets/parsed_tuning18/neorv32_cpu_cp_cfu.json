      "function": "2-stage done shift register indicating completion"
    },
    {
      "entity": "neorv32_cpu_cp_cfu",
      "name": "xtea.opa",
      "type": "std_ulogic_vector(31 downto 0)",
      "kind": "register",
      "function": "buffered input operand A (rs1)"
