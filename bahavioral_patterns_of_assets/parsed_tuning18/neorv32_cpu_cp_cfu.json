      "type": "std_ulogic_vector(31 downto 0)",
      "kind": "signal",
      "function": "select operand A between opb and opa"
    },
    {
      "entity": "neorv32_cpu_cp_cfu",
      "name": "tmp_b",
      "type": "std_ulogic_vector(31 downto 0)",
      "kind": "signal",
      "function": "select operand B between opa and opb"
    },
    {
      "entity": "neorv32_cpu_cp_cfu",
      "name": "tmp_x",
      "type": "std_ulogic_vector(31 downto 0)",
      "kind": "signal",
      "function": "selected v shifted left by 4 bits"
    },
    {
      "entity": "neorv32_cpu_cp_cfu",
      "name": "tmp_y",
      "type": "std_ulogic_vector(31 downto 0)",
      "kind": "signal",
      "function": "selected v shifted right by 5 bits"
    },
    {
      "entity": "neorv32_cpu_cp_cfu",
      "name": "tmp_z",
      "type": "std_ulogic_vector(31 downto 0)",
      "kind": "signal",
      "function": "select key_mem entry indexed by xtea.sum bits"
    },
    {
      "entity": "neorv32_cpu_cp_cfu",
      "name": "tmp_r",
      "type": "std_ulogic_vector(31 downto 0)",
      "kind": "signal",
      "function": "compute temporary r = (x xor y + a) xor (sum + key)"
    }
