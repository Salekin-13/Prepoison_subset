      "function": "funct3 field from instruction (3-bit select)"
    },
    {
      "entity": "neorv32_cpu_cp_cfu",
      "name": "funct7_i",
      "dir": "in",
      "type": "std_ulogic_vector(6 downto 0)",
      "function": "funct7 field from instruction (7-bit select)"
    },
    {
      "entity": "neorv32_cpu_cp_cfu",
      "name": "rs1_i",
      "dir": "in",
      "type": "std_ulogic_vector(31 downto 0)",
      "function": "source register 1 operand (32-bit)"
    },
    {
      "entity": "neorv32_cpu_cp_cfu",
      "name": "rs2_i",
      "dir": "in",
      "type": "std_ulogic_vector(31 downto 0)",
      "function": "source register 2 operand (32-bit)"
    },
    {
      "entity": "neorv32_cpu_cp_cfu",
      "name": "rs3_i",
      "dir": "in",
      "type": "std_ulogic_vector(31 downto 0)",
      "function": "source register 3 operand (32-bit, R4-type)"
    },
    {
      "entity": "neorv32_cpu_cp_cfu",
      "name": "result_o",
