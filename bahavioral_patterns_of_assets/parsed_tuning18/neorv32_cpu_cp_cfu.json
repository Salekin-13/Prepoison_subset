    },
    {
      "entity": "neorv32_cpu_cp_cfu",
      "name": "xtea",
      "type": "xtea_t",
      "kind": "register",
      "function": "XTEA core registers (operation state and buffers)"
    },
    {
      "entity": "neorv32_cpu_cp_cfu",
      "name": "xtea.done",
      "type": "std_ulogic_vector(1 downto 0)",
