/API.env
# ── secrets ──────────────────────────────────────────────
# API.env holds your Gemini/OpenAI keys. NEVER commit it.
API.env
*.env
.env*
!*.env.example

# ── generated artifacts & caches ─────────────────────────
# embeddings + chunk caches (rebuilt from corpus; fingerprint-keyed)
stage_a_out/rag_cache/
# LLM outputs: regenerable, but you may choose to version summaries/
# for provenance — if so, delete the next line.
stage_a_out/summaries/
*.npy

# ── external corpus (pinned, reproducible) ───────────────
# NEORV32 sources: don't vendor a third-party repo inside yours.
# Pin the commit hash in the README instead.
RTL_data/
neorv32/
parsed_tuning18/
parsed_tuning18*/

rag_cache_ada002/
summaries_tuning18/
summaries_tuning18*/

# Stage B output — same class as parsed_/summaries_ above: regenerable from the
# pipeline. Version a run only if you need its provenance alongside a paper claim.
assets_tuning18*/
assets_tuning18/

datasheet/
IPs/
# NEORV32 datasheet PDFs (~7 MB each, third-party). The notebook reads
# NEORV32-patched.pdf; keep it locally rather than vendoring it here.
*.pdf


# ── python ───────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
base/

# ── jupyter ──────────────────────────────────────────────
.ipynb_checkpoints/
# uncomment if you want clean diffs (strips outputs via nbstripout):
# *.ipynb.orig

# ── ml model caches (sentence-transformers/HF download dirs) ──
.cache/
models--*/

# ── os / editor ──────────────────────────────────────────
.vscode/
Thumbs.db
Desktop.ini
.DS_Store
