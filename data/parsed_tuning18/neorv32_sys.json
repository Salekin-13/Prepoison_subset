{
  "module": "neorv32_sys",
  "entities": [
    "neorv32_sys_reset",
    "neorv32_sys_clock"
  ],
  "ports": [
    {
      "entity": "neorv32_sys_reset",
      "name": "clk_i",
      "dir": "in",
      "type": "std_ulogic",
      "function": "global clock input (rising edge)"
    },
    {
      "entity": "neorv32_sys_reset",
      "name": "rstn_ext_i",
      "dir": "in",
      "type": "std_ulogic",
      "function": "external reset input, low-active, asynchronous"
    },
    {
      "entity": "neorv32_sys_reset",
      "name": "rstn_wdt_i",
      "dir": "in",
      "type": "std_ulogic",
      "function": "watchdog reset input, low-active, synchronous"
    },
    {
      "entity": "neorv32_sys_reset",
      "name": "rstn_dbg_i",
      "dir": "in",
      "type": "std_ulogic",
      "function": "debugger reset input, low-active, synchronous"
    },
    {
      "entity": "neorv32_sys_reset",
      "name": "rstn_ext_o",
      "dir": "out",
      "type": "std_ulogic",
      "function": "synchronized external reset output, low-active"
    },
    {
      "entity": "neorv32_sys_reset",
      "name": "rstn_sys_o",
      "dir": "out",
      "type": "std_ulogic",
      "function": "synchronized system reset output, low-active"
    },
    {
      "entity": "neorv32_sys_reset",
      "name": "xrstn_wdt_o",
      "dir": "out",
      "type": "std_ulogic",
      "function": "watchdog-derived processor reset output, low-active, synchronized"
    },
    {
      "entity": "neorv32_sys_reset",
      "name": "xrstn_ocd_o",
      "dir": "out",
      "type": "std_ulogic",
      "function": "on-chip-debugger-derived processor reset output, low-active, synchronized"
    },
    {
      "entity": "neorv32_sys_clock",
      "name": "clk_i",
      "dir": "in",
      "type": "std_ulogic",
      "function": "main system clock input (rising edge)"
    },
    {
      "entity": "neorv32_sys_clock",
      "name": "rstn_i",
      "dir": "in",
      "type": "std_ulogic",
      "function": "global asynchronous reset input (active-low)"
    },
    {
      "entity": "neorv32_sys_clock",
      "name": "enable_i",
      "dir": "in",
      "type": "std_ulogic_vector(NUM_EN-1 downto 0)",
      "function": "enable channels vector controlling clock tick generation"
    },
    {
      "entity": "neorv32_sys_clock",
      "name": "clk_en_o",
      "dir": "out",
      "type": "std_ulogic_vector(7 downto 0)",
      "function": "one-cycle clock-enable outputs for various divided clocks"
    }
  ],
  "signals": [
    {
      "entity": "neorv32_sys_reset",
      "name": "sreg_sys",
      "type": "std_ulogic_vector(3 downto 0)",
      "kind": "register",
      "function": "Shift register for internal (wdt/dbg) synchronized system reset"
    },
    {
      "entity": "neorv32_sys_reset",
      "name": "sreg_ext",
      "type": "std_ulogic_vector(3 downto 0)",
      "kind": "register",
      "function": "Shift register to synchronize external async reset"
    },
    {
      "entity": "neorv32_sys_clock",
      "name": "en",
      "type": "std_ulogic",
      "kind": "register",
      "function": "enable flag indicating any enable_i channel active"
    },
    {
      "entity": "neorv32_sys_clock",
      "name": "cnt",
      "type": "std_ulogic_vector(11 downto 0)",
      "kind": "register",
      "function": "12-bit counter incrementing when en is high"
    },
    {
      "entity": "neorv32_sys_clock",
      "name": "cnt2",
      "type": "std_ulogic_vector(11 downto 0)",
      "kind": "register",
      "function": "delayed cnt copy used for rising-edge detection"
    }
  ]
}