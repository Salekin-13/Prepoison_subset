{
  "module": "neorv32_trng",
  "entities": [
    "neorv32_trng",
    "neoTRNG",
    "neoTRNG_cell"
  ],
  "ports": [
    {
      "entity": "neorv32_trng",
      "name": "clk_i",
      "dir": "in",
      "type": "std_ulogic",
      "function": "global clock input for TRNG and submodules"
    },
    {
      "entity": "neorv32_trng",
      "name": "rstn_i",
      "dir": "in",
      "type": "std_ulogic",
      "function": "global reset input, active-low asynchronous"
    },
    {
      "entity": "neorv32_trng",
      "name": "bus_req_i",
      "dir": "in",
      "type": "bus_req_t",
      "function": "host/CPU bus request record input"
    },
    {
      "entity": "neorv32_trng",
      "name": "bus_req_i.addr",
      "dir": "in",
      "type": "std_ulogic_vector(31 downto 0)",
      "function": "32-bit bus request address"
    },
    {
      "entity": "neorv32_trng",
      "name": "bus_req_i.data",
      "dir": "in",
      "type": "std_ulogic_vector(31 downto 0)",
      "function": "32-bit bus write data"
    },
    {
      "entity": "neorv32_trng",
      "name": "bus_req_i.ben",
      "dir": "in",
      "type": "std_ulogic_vector(3 downto 0)",
      "function": "4-bit byte-enable mask for bus writes"
    },
    {
      "entity": "neorv32_trng",
      "name": "bus_req_i.stb",
      "dir": "in",
      "type": "std_ulogic",
      "function": "request strobe indicating a valid transaction"
    },
    {
      "entity": "neorv32_trng",
      "name": "bus_req_i.rw",
      "dir": "in",
      "type": "std_ulogic",
      "function": "'1' = write, '0' = read request flag"
    },
    {
      "entity": "neorv32_trng",
      "name": "bus_req_i.src",
      "dir": "in",
      "type": "std_ulogic",
      "function": "request source/master identifier (origin)"
    },
    {
      "entity": "neorv32_trng",
      "name": "bus_req_i.priv",
      "dir": "in",
      "type": "std_ulogic",
      "function": "privilege flag for the bus request"
    },
    {
      "entity": "neorv32_trng",
      "name": "bus_req_i.debug",
      "dir": "in",
      "type": "std_ulogic",
      "function": "debug access indicator for the request"
    },
    {
      "entity": "neorv32_trng",
      "name": "bus_req_i.amo",
      "dir": "in",
      "type": "std_ulogic",
      "function": "atomic memory operation (AMO) request indicator"
    },
    {
      "entity": "neorv32_trng",
      "name": "bus_req_i.amoop",
      "dir": "in",
      "type": "std_ulogic_vector(3 downto 0)",
      "function": "4-bit AMO operation code"
    },
    {
      "entity": "neorv32_trng",
      "name": "bus_req_i.lock",
      "dir": "in",
      "type": "std_ulogic",
      "function": "bus lock indicator for atomic sequences"
    },
    {
      "entity": "neorv32_trng",
      "name": "bus_req_i.fence",
      "dir": "in",
      "type": "std_ulogic",
      "function": "fence/order barrier indicator for the request"
    },
    {
      "entity": "neorv32_trng",
      "name": "bus_rsp_o",
      "dir": "out",
      "type": "bus_rsp_t",
      "function": "bus response record output to host/CPU"
    },
    {
      "entity": "neorv32_trng",
      "name": "bus_rsp_o.ack",
      "dir": "out",
      "type": "std_ulogic",
      "function": "acknowledge flag for processed request"
    },
    {
      "entity": "neorv32_trng",
      "name": "bus_rsp_o.err",
      "dir": "out",
      "type": "std_ulogic",
      "function": "response error indicator"
    },
    {
      "entity": "neorv32_trng",
      "name": "bus_rsp_o.data",
      "dir": "out",
      "type": "std_ulogic_vector(31 downto 0)",
      "function": "32-bit read response data"
    },
    {
      "entity": "neoTRNG",
      "name": "clk_i",
      "dir": "in",
      "type": "std_ulogic",
      "function": "module clock input"
    },
    {
      "entity": "neoTRNG",
      "name": "rstn_i",
      "dir": "in",
      "type": "std_ulogic",
      "function": "global reset, active-low asynchronous input"
    },
    {
      "entity": "neoTRNG",
      "name": "enable_i",
      "dir": "in",
      "type": "std_ulogic",
      "function": "module enable input (active-high) to start TRNG sampling"
    },
    {
      "entity": "neoTRNG",
      "name": "valid_o",
      "dir": "out",
      "type": "std_ulogic",
      "function": "data valid strobe (high when data_o contains valid byte)"
    },
    {
      "entity": "neoTRNG",
      "name": "data_o",
      "dir": "out",
      "type": "std_ulogic_vector(7 downto 0)",
      "function": "8-bit random data byte output"
    },
    {
      "entity": "neoTRNG_cell",
      "name": "clk_i",
      "dir": "in",
      "type": "std_ulogic",
      "function": "clock input for synchronous logic"
    },
    {
      "entity": "neoTRNG_cell",
      "name": "rstn_i",
      "dir": "in",
      "type": "std_ulogic",
      "function": "global reset, active-low asynchronous"
    },
    {
      "entity": "neoTRNG_cell",
      "name": "en_i",
      "dir": "in",
      "type": "std_ulogic",
      "function": "enable-chain input for inverter enable shift-register"
    },
    {
      "entity": "neoTRNG_cell",
      "name": "en_o",
      "dir": "out",
      "type": "std_ulogic",
      "function": "enable-chain output for chaining cell enables"
    },
    {
      "entity": "neoTRNG_cell",
      "name": "rnd_o",
      "dir": "out",
      "type": "std_ulogic",
      "function": "synchronized random-bit output (entropy source)"
    }
  ],
  "signals": [
    {
      "entity": "neorv32_trng",
      "name": "enable",
      "type": "std_ulogic",
      "kind": "register",
      "function": "TRNG enable control bit"
    },
    {
      "entity": "neorv32_trng",
      "name": "fifo_clr",
      "type": "std_ulogic",
      "kind": "register",
      "function": "FIFO clear control bit (auto-clears)"
    },
    {
      "entity": "neorv32_trng",
      "name": "fifo",
      "type": "fifo_t",
      "kind": "signal",
      "function": "FIFO interface record (control, data, status)"
    },
    {
      "entity": "neorv32_trng",
      "name": "fifo.we",
      "type": "std_ulogic",
      "kind": "signal",
      "function": "FIFO write enable from neoTRNG valid output"
    },
    {
      "entity": "neorv32_trng",
      "name": "fifo.re",
      "type": "std_ulogic",
      "kind": "signal",
      "function": "FIFO read enable for bus data reads"
    },
    {
      "entity": "neorv32_trng",
      "name": "fifo.clear",
      "type": "std_ulogic",
      "kind": "signal",
      "function": "Synchronous FIFO clear when disabled or fifo_clr"
    },
    {
      "entity": "neorv32_trng",
      "name": "fifo.wdata",
      "type": "std_ulogic_vector(7 downto 0)",
      "kind": "signal",
      "function": "Write data byte into FIFO from neoTRNG"
    },
    {
      "entity": "neorv32_trng",
      "name": "fifo.rdata",
      "type": "std_ulogic_vector(7 downto 0)",
      "kind": "signal",
      "function": "Read data byte output from FIFO to bus"
    },
    {
      "entity": "neorv32_trng",
      "name": "fifo.avail",
      "type": "std_ulogic",
      "kind": "signal",
      "function": "Indicates FIFO has data available"
    },
    {
      "entity": "neorv32_trng",
      "name": "fifo.half",
      "type": "std_ulogic",
      "kind": "signal",
      "function": "Indicates FIFO at least half full"
    },
    {
      "entity": "neorv32_trng",
      "name": "fifo.free",
      "type": "std_ulogic",
      "kind": "signal",
      "function": "Indicates FIFO has free space (entries)"
    },
    {
      "entity": "neoTRNG",
      "name": "cell_en_in",
      "type": "std_ulogic_vector(NUM_CELLS-1 downto 0)",
      "kind": "signal",
      "function": "enable shift-register input for entropy cells"
    },
    {
      "entity": "neoTRNG",
      "name": "cell_en_out",
      "type": "std_ulogic_vector(NUM_CELLS-1 downto 0)",
      "kind": "signal",
      "function": "enable shift-register output from each entropy cell"
    },
    {
      "entity": "neoTRNG",
      "name": "cell_rnd",
      "type": "std_ulogic_vector(NUM_CELLS-1 downto 0)",
      "kind": "signal",
      "function": "raw random output bit from each entropy cell"
    },
    {
      "entity": "neoTRNG",
      "name": "cell_sum",
      "type": "std_ulogic",
      "kind": "signal",
      "function": "XOR-combined random bit from all cells"
    },
    {
      "entity": "neoTRNG",
      "name": "debias_sreg",
      "type": "std_ulogic_vector(1 downto 0)",
      "kind": "register",
      "function": "two-bit shift register sampling recent combined bits"
    },
    {
      "entity": "neoTRNG",
      "name": "debias_state",
      "type": "std_ulogic",
      "kind": "register",
      "function": "toggles to trigger de-biasing every second cycle"
    },
    {
      "entity": "neoTRNG",
      "name": "debias_valid",
      "type": "std_ulogic",
      "kind": "signal",
      "function": "indicates a valid de-biased bit (edge detected)"
    },
    {
      "entity": "neoTRNG",
      "name": "debias_data",
      "type": "std_ulogic",
      "kind": "signal",
      "function": "de-biased output bit (extracted data)"
    },
    {
      "entity": "neoTRNG",
      "name": "sample_en",
      "type": "std_ulogic",
      "kind": "register",
      "function": "registered global sampling enable (mirrors enable_i)"
    },
    {
      "entity": "neoTRNG",
      "name": "sample_sreg",
      "type": "std_ulogic_vector(7 downto 0)",
      "kind": "register",
      "function": "LFSR-style shift register mixing de-biased bits"
    },
    {
      "entity": "neoTRNG",
      "name": "sample_cnt",
      "type": "std_ulogic_vector(6 downto 0)",
      "kind": "register",
      "function": "counts de-biased bits per sample (64-bit sample)"
    },
    {
      "entity": "neoTRNG_cell",
      "name": "sreg",
      "type": "std_ulogic_vector(NUM_INV-1 downto 0)",
      "kind": "register",
      "function": "enable shift-register for per-inverter enables"
    },
    {
      "entity": "neoTRNG_cell",
      "name": "latch",
      "type": "std_ulogic_vector(NUM_INV-1 downto 0)",
      "kind": "signal",
      "function": "ring-oscillator latches with reset and enable transparency"
    },
    {
      "entity": "neoTRNG_cell",
      "name": "inv_in",
      "type": "std_ulogic_vector(NUM_INV-1 downto 0)",
      "kind": "signal",
      "function": "inverter input chain driven from latches"
    },
    {
      "entity": "neoTRNG_cell",
      "name": "inv_out",
      "type": "std_ulogic_vector(NUM_INV-1 downto 0)",
      "kind": "signal",
      "function": "inverter outputs for ring-oscillator stages"
    },
    {
      "entity": "neoTRNG_cell",
      "name": "sync",
      "type": "std_ulogic_vector(1 downto 0)",
      "kind": "register",
      "function": "two-stage synchronizer sampling latch output"
    }
  ]
}